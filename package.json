{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build experiments/wasm --release --target web",
    "test:wasm": "cargo test --manifest-path experiments/wasm/Cargo.toml",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test test/origins.test.ts test/imports.test.ts test/diagnostics.test.ts test/settings.test.ts test/environment.test.ts test/backend-wasm.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
